# ==============================================================================
# Academic & Hostel Resource Allocation Optimization Dashboard (AHRAO)
# Environment Configuration Template
# NOTE: Copy this file to `.env` in frontend/ and backend/ (or set in system env)
# NEVER commit real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# Backend Configuration (Spring Boot + MySQL + JWT)
# ------------------------------------------------------------------------------
# Server
PORT=8080

# Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=academic_hostel_resource_allocation
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Full JDBC URL (Optional override, defaults to jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME})
DB_URL=jdbc:mysql://localhost:3306/academic_hostel_resource_allocation?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT Security
# Must be a cryptographically secure random string with minimum 256 bits (32+ chars)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# AI Service Configuration (FastAPI + Scikit-Learn)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_CONNECT_TIMEOUT_MS=3000
AI_READ_TIMEOUT_MS=8000
MIN_TRAINING_RECORDS=5


